{
  "compilerOptions": {
    "declaration": true,
    "module": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "es2024",
    "lib": ["es2023", "dom", "dom.iterable"],
    "moduleResolution": "node16",
    "composite": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
